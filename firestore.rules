rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'manager', 'booking_executive', 'accounts']) ||
        request.auth.token.email == 'omkarsonawane740@gmail.com'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin() || !isSignedIn();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Services Catalog
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories
    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Packages
    match /packages/{packageId} {
      allow read: if true;
      allow write: if true;
    }

    // Addons
    match /addons/{addonId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Staff
    match /staff/{staffId} {
      allow read: if true;
      allow write: if true;
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    // Offers
    match /offers/{offerId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // FAQs
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    // Contact Messages
    match /contactMessages/{messageId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }
  }
}
